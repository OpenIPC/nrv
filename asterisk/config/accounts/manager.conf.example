; Пользователь AMI для сервера. Права минимальные: только команды
; перезагрузки (command) и чтение состояния (system, report).
;
; Пользователь нужен ровно один: сервер — единственный, кто управляет
; конфигурацией. Второй пользователь означал бы второе место с паролем,
; которое надо менять при развёртывании.

[nvr]
secret = changeme_ami_secret
read = command,system,report
write = command,system
