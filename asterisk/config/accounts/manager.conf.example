; Пользователь AMI для сервера. Права минимальные: команды
; перезагрузки (command), чтение состояния (system, report) и события
; звонков (call).
;
; Категория call нужна для уведомлений о пропущенных вызовах: без неё
; сервер видит состав абонентов, но не видит самих звонков — события
; DialBegin и DialEnd ему не приходят.
;
; Пользователь нужен ровно один: сервер — единственный, кто управляет
; конфигурацией. Второй пользователь означал бы второе место с паролем,
; которое надо менять при развёртывании.

[nvr]
secret = changeme_ami_secret
read = command,system,report,call
write = command,system
