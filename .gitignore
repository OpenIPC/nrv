# NVR Video Surveillance System

# --- Зависимости ---
node_modules/
dist/
build/

# --- Go ---
backend/tmp/
# Скомпилированный бинарник: собирается в Docker, в репозитории не нужен.
backend/server

# --- Артефакты приложения ---
# Модель YOLO скачивается автоматически при первом запуске ai-detector.
*.pt
# Записи и снапшоты
recordings/
backups/
# Логи
*.log
nohup.out

# --- Секреты и окружение ---
.env
*.env
!.env.example

# --- Локальные материалы ---
#
# Ниже перечислены каталоги, которые могут лежать рядом с проектом на
# машине разработчика, но в репозиторий не входят. Содержимое у них
# разное и в разное время меняется, поэтому перечисляем их по именам.
#
# Шаблон с косой чертой впереди — чтобы правило срабатывало для папки
# в любом месте дерева, а не только в корне. Обход подкаталогов уже
# включён (выше указаны каталоги, поэтому git не пропускает содержимое).

# Материалы для разбора протоколов и работы с оборудованием: держим
# локально, в репозиторий не выкладываем.
/reference/
# Справка вендора по ISAPI разбиралась при работе над доступом к камерам
# Hikvision. Это документация производителя объёмом в мегабайты, и в
# репозитории ей места нет — как и остальным справочным материалам.
/DS_Series_API/
# Фотографии наклеек и корпусов устройств из корня репозитория.
# Наклейка контроллера содержит ключ авторизации: он даёт доступ к
# устройству, и в публичном репозитории ему не место. Правило узкое —
# только снимки с телефона в корне, а не все изображения подряд: картинки
# интерфейса и подложки планов лежат в своих каталогах и нужны в репозитории.
/IMG_*.jpg
/IMG_*.jpeg
/IMG_*.png
# Страховка: если каталог переименуют, правило продолжит работать по
# характерным для него файлам (исполняемые файлы, образы прошивок,
# справка, файлы конфигурации окружения).
*.exe
*.rom
*.chm
*.lic

# Выгрузка встроенного веб-интерфейса устройства.
/device-ui/

# Копия внешней документации. В репозитории она не нужна: документация
# ведётся в docs/ и plans/ этого же репозитория, а копия расходилась бы
# с ними и вводила в заблуждение.
/docs-archive/

# --- IDE ---
.vscode/
.idea/
*.swp
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Docker ---
pgdata/
minio_data/
# Файл, который установщик создаёт из docker-compose.gpu.yml, если на машине
# есть видеокарта. Он описывает конкретную установку (наличие карты),
# а не проект, поэтому в репозитории ему места нет — образец лежит рядом
# в docker-compose.gpu.yml.
docker-compose.override.yml

# --- Временные файлы ---
*.tmp
.cache/
.venv-recode/

# --- Python ---
# Кэш байт-кода: создаётся при запуске и пересборке модулей.
__pycache__/
*.pyc

# --- Локальные модели ---
# Модель YAMNet скачивается при сборке образа ai-detector.
ai-detector/models/

# --- Прошивка СКУД-контроллера (ESP32-P4) ---
# Артефакты сборки ESP-IDF: каталог build занимает сотни мегабайт
# и полностью пересоздаётся командой idf.py build.
firmware/skud-esp32-p4/build/
# Компоненты, скачанные менеджером зависимостей: восстанавливаются
# по dependencies.lock и idf_component.yml.
firmware/skud-esp32-p4/managed_components/
firmware/skud-esp32-p4/sdkconfig
firmware/skud-esp32-p4/sdkconfig.old
firmware/skud-esp32-p4/dependencies.lock
# Готовые образы прошивки: собираются локально и не хранятся в репозитории.
firmware/skud-esp32-p4/*.bin
# Документация и материалы производителя: в репозитории не нужны.
firmware/skud-esp32-p4/*.pdf
firmware/skud-esp32-p4/*.jpg
firmware/skud-esp32-p4/*-DEV-KIT*.html
firmware/skud-esp32-p4/*_files/
firmware/skud-esp32-p4/.vscode/

# Дампы схем и парсера документации
schema_dump.txt
schematic.txt

# --- Мобильное приложение (React Native / Android) ---
mobile/node_modules/
mobile/android/app/build/
mobile/android/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/debug/
mobile/android/app/release/
mobile/.expo/
mobile/ios/Pods/
mobile/ios/build/
# Ключи подписи: приватный ключ не должен попадать в репозиторий.
*.keystore
*.jks

# Артефакты сборки мобильного приложения: собираются локально.
app-debug.zip
mobile/*.zip

# --- Материалы для разработки (не часть проекта) ---
# Документация, скачанная для изучения. Весит десятки мегабайт и
# обновляется независимо от нас: держать её в репозитории смысла нет,
# а место она занимает заметно. Ссылка на источник есть в плане.
/docs-archive/

# Фотографии экранов и установочные файлы, снятые вручную.
# В документацию попадают только обработанные снимки из docs/screenshots,
# а это исходники: они большие и в репозитории не нужны.
/tel/
/АндроидТВ/

# Справочные материалы для работы: описания протоколов, примеры
# интеграции, техдокументация. В репозитории они только засоряют
# историю бинарными файлами.
/reference/

# Рабочий конфиг пилота go2rtc: go2rtc дописывает в него адреса камер
# с учётными данными при добавлении через API. В репозитории остаётся
# только образец — go2rtc.example.yaml.
go2rtc/go2rtc.yaml

# Абоненты SIP и правила групп: файлы собирает сервер из базы,
# в них пароли устройств. Образцы — рядом, с расширением .example.
asterisk/config/accounts/*.conf
