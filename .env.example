# NVR Backend — переменные окружения
# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Основное ---
PORT=8080
LOG_LEVEL=info
LOG_FORMAT=console

# Подключение к PostgreSQL.
# Порт 5434 — внешний порт контейнера postgres (см. docker-compose.yml).
DATABASE_URL=postgres://nvr:nvr_secret@localhost:5434/nvr?sslmode=disable

# Пароль базы данных. Используется и при создании контейнера postgres.
DB_PASSWORD=nvr_secret

# --- Безопасность ---
# ОБЯЗАТЕЛЬНО смените! Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-random-string

# --- Архив видеозаписей: где хранятся записи и снимки ---
# По умолчанию архив пишется на локальный диск сервера (том nvr_data,
# режим "local" в настройках сервера). Это штатный вариант: публичные образы
# MinIO убраны из реестров, и контейнер S3 при установке не поднимается.
#
# Для внешнего S3-хранилища укажите его адрес и ключи ниже, а контейнер MinIO
# поднимите профилем: docker compose --profile minio up -d
#
# Пустой MINIO_ENDPOINT означает «S3 не используется» — бэкенд не пытается
# подключиться и пишет файлы на диск.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nvr-recordings
# Адрес хранилища, доступный браузеру — используется в presigned-ссылках.
# Если сервер открыт извне, укажите внешний адрес или домен.
# Пример: MINIO_PUBLIC_ENDPOINT=192.168.1.111:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_USE_SSL=false

# --- NATS (обмен кадрами с AI-детектором) ---
NATS_URL=nats://localhost:4222

# --- Медиасервер go2rtc ---
# API — регистрация потоков, список, HTTP-кадры; RTSP — отдача потоков
# наружу по протоколу RTSP (см. EXTERNAL-RTSP.md).
GO2RTC_API=http://localhost:1984
GO2RTC_RTSP=localhost:8554

# Адрес go2rtc, доступный браузеру оператора. Пусто — ссылки строятся
# по адресу запроса.
GO2RTC_PUBLIC_HOST=

# --- Внешний RTSP-доступ ---
# Учётные данные, под которыми сторонние системы (видеостены, регистраторы,
# аналитика) читают потоки на порту 9784.
#
# ОБЯЗАТЕЛЬНО смените пароль перед выводом сервера в сеть!
# Внешнему пользователю разрешено только чтение: публиковать в наши пути
# и менять конфигурацию сервера он не может.
#
# Адреса потоков: rtsp://ЛОГИН:ПАРОЛЬ@АДРЕС:9784/cameras/{НОМЕР-1}/streaming/{main|sub}
# Список каналов с готовыми ссылками — на странице «Внешний доступ».
EXTERNAL_RTSP_USER=viewer
EXTERNAL_RTSP_PASS=viewer

# --- AI-детектор: где считать объекты ---
#
# Заполняется установщиком (install.sh), менять вручную нужно редко.
#
# cpu  — счёт на процессоре: вариант для машин без видеокарты, образ
#        меньше примерно на 8 ГБ и собирается быстрее;
# cuda — счёт на видеокарте NVIDIA (нужен драйвер на хосте).
AI_DEVICE=cpu
# База образа детектора и индекс PyTorch, из которого ставится torch.
# Для GPU это nvidia/cuda:12.6.2-cudnn-runtime-ubuntu24.04 и
# https://download.pytorch.org/whl/cu126 — их подставляет установщик.
AI_BASE_IMAGE=ubuntu:24.04
AI_TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# --- Распознавание автомобильных номеров ---
# Для камер с включённым распознаванием номеров работает отдельный быстрый
# поток кадров: чаще обычного и только по зоне поиска номера. Так машина
# гарантированно попадает в кадр — обычный поток идёт раз в секунду, а
# машина проезжает зону за 2-3 секунды.
#
# Зона поиска номера задаётся в интерфейсе, в карточке камеры.
# Без неё быстрый поток не запускается: кадрировать нечего.
#
# Интервал кадров зоны в секундах (0.2 = 5 кадров в секунду).
PLATE_FRAME_INTERVAL=0.2
# Ширина кадра зоны. Номер занимает 100-150 пикселей — этого хватает OCR.
PLATE_FRAME_WIDTH=640

# --- WireGuard (опционально) ---
# Интерфейс для подключения удалённых камер за NAT.
# Если не задан, управление туннелями отключено.
# WG_INTERFACE=wg0

# --- SIP-домофония ---
#
# Подсистема звонков с вызывных панелей на видеодомофоны, трубки и приложения
# работает на отдельном контейнере Asterisk (профиль sip):
#   docker compose --profile sip up -d
#
# Каталог конфигурации Asterisk для записи абонентов и правил вызова.
# Пусто — сервер конфигурацией не управляет, раздел работает только с базой.
# Задаёт установщик (install.sh --sip).
ASTERISK_CONFIG_DIR=/etc/asterisk
# Адрес интерфейса управления Asterisk (AMI), через который сервер
# перезагружает конфигурацию, не разрывая идущие разговоры.
ASTERISK_AMI_ADDR=127.0.0.1:5038
ASTERISK_AMI_USER=nvr
# Пароль AMI. Пусто — файлы будут записаны, но подхватятся только после
# перезапуска Asterisk. Значение установщик пишет в manager.conf и сюда.
ASTERISK_AMI_SECRET=
# Пароль управления медиасессиями (ARI). Пока не используется сервером,
# но нужен модулю SIP по WebSocket: без него приложения не подключаются.
# Служебное значение, менять вручную не нужно.
ASTERISK_ARI_SECRET=

# Обновление сервера из репозитория (вкладка «Обновления» на странице /server)
#
# Каталог установки на хосте: по нему служба агента (nvr-agent) находит
# git-коммит работающей версии и обновляется из репозитория. Пусто —
# каталог по умолчанию самой службы (обычно /opt/nvr).
#
# Важно: у службы агента домашние каталоги закрыты (ProtectHome=yes),
# поэтому каталог установки должен лежать вне /home.
NVR_INSTALL_DIR=/opt/nvr
# Адрес репозитория, откуда берутся обновления. Не вшит в код: установки
# живут на разных площадках — GitHub, GitVerse, локальное зеркало.
# Значение записывает установщик (install.sh), менять можно вручную.
UPDATE_REPO_URL=https://github.com/OpenIPC/nrv
# Ветка обновлений.
UPDATE_BRANCH=main
