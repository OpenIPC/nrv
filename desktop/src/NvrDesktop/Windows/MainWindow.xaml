<Window x:Class="NvrDesktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NVR Control"
        Height="720" Width="1100"
        Background="#0f1419"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#1a2028"/>
            <Setter Property="Foreground" Value="#e6edf3"/>
            <Setter Property="BorderBrush" Value="#2d3742"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок с состоянием связи -->
        <Border Grid.Row="0" Background="#131a22" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Камеры"
                               Foreground="#e6edf3"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="ServerText"
                               Foreground="#8b98a5"
                               FontSize="12"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Обновить"
                        Margin="0,0,8,0"
                        Click="OnRefreshClick"/>

                <Button Grid.Column="2"
                        Content="Новая сцена"
                        ToolTip="Открыть окно для выбранной камеры на другом мониторе"
                        Click="OnNewSceneClick"/>
            </Grid>
        </Border>

        <!-- Список камер -->
        <ListView x:Name="CameraList"
                  Grid.Row="1"
                  Margin="16"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="#e6edf3"
                  MouseDoubleClick="OnCameraDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="12,10"/>
                    <Setter Property="Margin" Value="0,0,0,4"/>
                    <Setter Property="Background" Value="#131a22"/>
                    <Setter Property="Foreground" Value="#e6edf3"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Кружок состояния: зелёный у камер в сети -->
                        <Ellipse Grid.Column="0"
                                 Width="10" Height="10"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#6b7280"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                            <Setter Property="Fill" Value="#34c759"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="14"
                                       FontWeight="Medium"/>
                            <TextBlock Foreground="#8b98a5"
                                       FontSize="12"
                                       Margin="0,2,0,0">
                                <Run Text="{Binding Ip, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding Status, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Смотреть"
                                Padding="16,6"
                                Click="OnWatchClick"
                                Tag="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--
          Подсказка внизу. Двойной щелчок по камере — основное действие,
          и о нём стоит сказать: кнопка «Смотреть» есть, но по списку
          естественнее щёлкать дважды.
        -->
        <Border Grid.Row="2" Background="#131a22" Padding="16,8">
            <TextBlock x:Name="StatusText"
                       Foreground="#8b98a5"
                       FontSize="12"
                       Text="Двойной щелчок по камере открывает окно просмотра"/>
        </Border>
    </Grid>
</Window>
