<Application x:Class="NvrDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!--
          Общие кисти приложения.

          Тёмное оформление выбрано не для красоты: операторы смотрят
          камеры часами, и светлая рамка вокруг тёмного видео утомляет
          глаза сильнее, чем тёмная вокруг тёмного.
        -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0f1419"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#131a22"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2d3742"/>
        <SolidColorBrush x:Key="TextBrush" Color="#e6edf3"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8b98a5"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2f81f7"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#34c759"/>
    </Application.Resources>
</Application>
