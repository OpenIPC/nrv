<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      WebRTC: состояние сети нужно для отслеживания смены Wi-Fi/мобильной
      сети и перезапуска соединения, а не для сбора данных.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Двусторонний звук: микрофон телефона передаётся в камеру (backchannel).
      Система спросит разрешение при первом включении; отказ не ломает
      остальные функции — просмотр остаётся со звуком из камеры.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!--
      Камера — только для видеозвонков с панели: без этого разрешения
      приложение падало при наборе номера. Видео в домофонии не роскошь:
      по нему видно, кто стоит у двери, и отказываться от него на телефоне
      незачем. Если разрешения нет, приложение само позвонит со звуком.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
      Телефонная линия.

      Служба переднего плана с постоянным уведомлением — единственный способ
      удержать приложение работающим в фоне: без неё Android останавливает
      процесс, рвётся соединение с Asterisk, и звонок с калитки приходит
      только при открытом приложении.

      Типы службы (dataSync — соединение, microphone — разговор с погашенным
      экраном) требуются начиная с Android 14: система должна знать, чем
      занята служба, а приложению нужны соответствующие разрешения.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Уведомление о линии: без разрешения его не видно, и система
         может не запустить службу на Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Соединение не должно засыпать вместе с экраном: иначе входящий
         звонок откладывается до включения телефона. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Wi-Fi тоже не должен уходить в экономичный режим: в нём пауза между
         пакетами доходит до секунд, и вызов не успевает дойти. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!--
      Работа без ограничений по батарее.

      Нужна не для экономии, а против заморозки: прошивки Transsion (TECNO)
      и подобные «гибернируют» приложение через несколько секунд после ухода
      в фон даже при работающей службе переднего плана — процесс замораживается
      и перестаёт принимать вызовы. Исключение из оптимизации батареи выводит
      приложение из этого списка.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      Показ входящего вызова на весь экран поверх блокировки.

      Без него на заблокированном телефоне вызов только звонит: кто звонит и
      кнопка ответа появляются лишь после разблокировки, и вызов легко
      пропустить.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
      Приложение работает и на телевизоре, и на телефоне.

      Отдельной сборки для ТВ не делаем: код общий, различается только
      интерфейс. Два APK пришлось бы править и проверять дважды.
    -->

    <!-- Телевизор: пульт вместо касаний, поэтому касание не обязательно. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Телевизор запускает приложение из своей ленты, а не с рабочего стола. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="true"
      android:supportsRtl="true"
      android:banner="@mipmap/ic_launcher">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <!--
          Категория LEANBACK_LAUNCHER выводит приложение в ленту Android TV,
          LAUNCHER оставлен для обычного списка на телефоне.
        -->
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- Служба телефонной линии. exported=false: управлять ею может
           только само приложение. -->
      <service
        android:name=".SipForegroundService"
        android:exported="false"
        android:foregroundServiceType="dataSync|microphone" />
    </application>
</manifest>
